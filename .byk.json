{
	"$paths": [
		"${file_dir}\\.venv\\Scripts"
	],
	"$var": {
		"github": "https://github.com/fcbyk/slide/releases/download/dist",
		"version": "2026.6.27"
	},
	"$deps": {
		"pip": [
			"${github}/slide-${version}-py3-none-any.whl"
		]
	},
	"py": {
		"$private": true,
		"$clone": false,
		"venv": "python -m venv .venv",
		"install": ".venv\\Scripts\\pip.exe install -e server",
		"uninstall": ".venv\\Scripts\\pip.exe uninstall -y slide"
	},
	"slide": {
		"$mode": "silent",
		"$cmd": "python -m slide.cli",
		"$description": "control slides via mobile web page"
	}
}